<?xml version="1.0" encoding="utf-8"?>
<!--
  Rien ne quitte le casque : ni sauvegarde cloud, ni transfert vers un autre appareil. Sur
  Android 12+, allowBackup="false" ne suffit plus à bloquer le transfert d'appareil à appareil,
  or filesDir/adb/ contient la clé ADB privée de l'appli (FR-027).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
